BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
BreakBeforeBraces: Linux
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AlignTrailingComments: true
AlignConsecutiveMacros: AcrossComments
AlignArrayOfStructures: Left
IndentCaseLabels: false
PointerAlignment: Right
SortIncludes: CaseSensitive
IncludeBlocks: Merge
IncludeCategories:
  - Regex: '^"(adf|adventure|bytes|crc32|csb_image|csb_text|file|ftl|graphics|ids|kaos|kaos_addresses|os|settings|spells|swsh|tables|vdeo)\.h"$'
    Priority: 1
  - Regex: '^"(action|arith|champion|discard|dungeon|event|explored|game|group|inventory|magic|map|message|move|party|projectile|random|record|recruit|savefile|savegame|sensor|sound|timeline)\.h"$'
    Priority: 2
  - Regex: '^"(advanced|anim|audio|automap|cheats|command|dialog|draw|entrance|frame|gameloop|layout|logo|menus|music|music_internal|optmenu|palette|panel|rows|select|slotlist|startend|status|text|ui|video|view|view_internal)\.h"$'
    Priority: 3
  - Regex: '^"(control|control_internal|json|png|request|state_json|turn)\.h"$'
    Priority: 4
  - Regex: '^"(app|debug_view|options|platform|scale|transport)\.h"$'
    Priority: 5
  - Regex: '^<(dr_mp3|SDL3)/'
    Priority: 6
  - Regex: '^<'
    Priority: 7
ReflowComments: false
